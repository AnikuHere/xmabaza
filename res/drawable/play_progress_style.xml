<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:width="2.0dip" android:color="@color/audio_seekbar_bg" />
            <corners android:radius="1.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape>
                <stroke android:width="2.0dip" android:color="@color/c_333333" />
                <corners android:radius="1.0dip" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <stroke android:width="2.0dip" android:color="@color/audio_seekbar_color" />
                <corners android:radius="1.0dip" />
            </shape>
        </scale>
    </item>
</layer-list>